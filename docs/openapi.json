         "type": "null"
        }
       ],
       "title": "Mood"
      }
     },
     {
      "name": "trope",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "array",
         "items": {
          "type": "string"
         },
         "maxItems": 20
        },
        {
         "type": "null"
        }
       ],
       "title": "Trope"
      }
     },
     {
      "name": "avoid",
      "in": "query",
