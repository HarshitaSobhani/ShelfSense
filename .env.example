# Copy to .env and edit. Never commit real values.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=shelfsense
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=shelfsense

# --- API (read by the app with the SHELFSENSE_ prefix) ---
# Required in production: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SHELFSENSE_SECRET_KEY=replace-with-a-long-random-string
SHELFSENSE_ENVIRONMENT=development          # development | production
SHELFSENSE_DATABASE_URL=postgresql+psycopg://shelfsense:change-me-locally@localhost:5432/shelfsense
SHELFSENSE_COOKIE_SECURE=false              # set true behind HTTPS
SHELFSENSE_CORS_ORIGINS=http://localhost:5173
SHELFSENSE_ADMIN_EMAILS=                    # comma-separated; these emails become admins when they register
SHELFSENSE_SESSION_DAYS=7

# --- Embeddings ---
SHELFSENSE_EMBEDDING_PROVIDER=sentence-transformers   # or "none" to force the keyword/metadata fallback
SHELFSENSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SHELFSENSE_EMBEDDING_MODEL_REVISION=main              # pin a commit hash for reproducible indexes
SHELFSENSE_EMBEDDING_DIM=384
SHELFSENSE_HYBRID_LEXICAL_WEIGHT=0.05
SHELFSENSE_MIN_SEMANTIC_SCORE=0.15
SHELFSENSE_SEARCH_RELATIVE_CUTOFF=0.5
# HF_HOME=/models          # where the model is cached (Docker: mounted volume)
# HF_HUB_OFFLINE=1         # after the first download, prevents network calls

# --- Open Library (no key needed). Open Library asks for a contact address in the User-Agent. ---
SHELFSENSE_OPENLIBRARY_CONTACT=you@example.com

# --- Limits ---
SHELFSENSE_MAX_BODY_BYTES=65536
SHELFSENSE_RATE_LIMIT_PER_MINUTE=240
SHELFSENSE_AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Tests (optional override) ---
# SHELFSENSE_TEST_DATABASE_URL=postgresql+psycopg://shelfsense:change-me-locally@localhost:5432/shelfsense_test

# --- Frontend dev server ---
# VITE_API_TARGET=http://localhost:8000
